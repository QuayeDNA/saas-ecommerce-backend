# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# Database Configuration
DBURI=mongodb://localhost:27017/saas-ecommerce

# Authentication Secrets (Generate your own!)
JWTSECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Server Configuration
PORT=5050
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email Configuration (Development)
EMAIL_PORT=1025

# Email Configuration (Production)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Redis Cache Configuration
CACHE_TTL_DEFAULT=3600
CACHE_TTL_SESSIONS=86400
CACHE_TTL_COMMISSIONS=1800
CACHE_TTL_ANALYTICS=300
CACHE_TTL_SETTINGS=7200

# Redis Connection Pool
REDIS_MAX_CONNECTIONS=20
REDIS_MIN_CONNECTIONS=2
REDIS_CONNECTION_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=3000

# MTN Mobile Money Configuration
# Get these from MTN Developer Portal
MTN_SUBSCRIPTION_KEY=d0ed95655ab04fb4804e6b6ad591411d  # Primary key from portal
MTN_API_USER=your_api_user_uuid  # Create via provisioning API
MTN_API_KEY=your_api_key  # Generate for the API user
MTN_MERCHANT_PHONE=233xxxxxxxxx  # Merchant phone number in international format
MTN_BASE_URL_SANDBOX=https://sandbox.momodeveloper.mtn.com
MTN_BASE_URL_PRODUCTION=https://momodeveloper.mtn.com
MTN_CALLBACK_URL_SANDBOX=https://your-domain.com/api/wallet/mtn-webhook
MTN_CALLBACK_URL_PRODUCTION=https://your-domain.com/api/wallet/mtn-webhook