# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# Database Configuration
DBURI=mongodb://localhost:27017/saas-ecommerce
# Optional: Separate production database (for createOrderDocument.js script)
# PROD_DBURI=mongodb://your-production-host/saas-ecommerce

# Authentication Secrets (Generate your own!)
JWTSECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Server Configuration
PORT=5050
NODE_ENV=development
# Development frontend URL (local)
FRONTEND_URL=http://localhost:5173
# In production, your frontend domains are brytelinks.com and directdata.shop

# OTP Delivery: "email" (free, via Gmail), "log" (console dev), "vonage", "twilio"
SMS_PROVIDER=email

# Email Configuration (Development)
EMAIL_PORT=1025

# Email Configuration (Production)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Redis Cache Configuration
CACHE_TTL_DEFAULT=3600
CACHE_TTL_SESSIONS=86400
CACHE_TTL_ANALYTICS=300
CACHE_TTL_SETTINGS=7200

# Redis Connection Pool
REDIS_MAX_CONNECTIONS=20
REDIS_MIN_CONNECTIONS=2
REDIS_CONNECTION_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=3000

# Storefront Cleanup
# Number of days to retain cancelled storefront orders before deleting them.
CANCELLED_STOREFRONT_ORDER_TTL_DAYS=30

# Storefront pending payment expiry (auto-cancel)
# Orders in "pending_payment" will be automatically cancelled after this many hours.
STORE_FRONT_PENDING_PAYMENT_EXPIRY_HOURS=24

# App context resolution
# App A = brytelinks.com
# App B = directdata.shop
APP_IDS=app_a,app_b
DEFAULT_APP_ID=app_a
STOREFRONT_APP_ID=app_b

# App A (BryteLinks)
APP_A_ALIASES=app_a,app-a,appa,brytelinks,brytelinks.com,main,admin
APP_A_ORIGINS=brytelinks.com,www.brytelinks.com,brytelink-chi.vercel.app,saas-ecommerce.vercel.app,localhost:5173,localhost:3000

# App B (DirectData)
APP_B_ALIASES=app_b,app-b,appb,directdata,directdata.shop
APP_B_ORIGINS=directdata.shop,www.directdata.shop,localhost:5174

# Optional per-app manifest overrides as JSON (advanced)
# APP_A_MANIFEST_JSON={"name":"App A Name","short_name":"AppA","description":"...","categories":["business"]}
# APP_B_MANIFEST_JSON={"name":"App B Name"}

# Phase 3: app-aware code generation
# Keep false until both frontends send x-client-app and prefixes are configured.
APP_AWARE_CODE_GENERATION_ENABLED=false

# Optional per-app code prefixes (defaults preserve legacy behavior)
# For additional app ids, add matching prefix variables, e.g. APP_C_ORDER_PREFIX.
# Order number prefixes
APP_A_ORDER_PREFIX=ORD
APP_B_ORDER_PREFIX=DRD

# Storefront order number prefixes
APP_A_STOREFRONT_ORDER_PREFIX=BAGS
APP_B_STOREFRONT_ORDER_PREFIX=DDST

# Agent code prefixes
APP_A_AGENT_PREFIX=BLA
APP_B_AGENT_PREFIX=DDA

# Example third app (app_c):
# APP_IDS=app_a,app_b,app_c
# APP_C_ALIASES=app_c,app-c,mythirdapp
# APP_C_ORIGINS=thirdapp.example.com,localhost:5175
# APP_C_ORDER_PREFIX=THR
# APP_C_STOREFRONT_ORDER_PREFIX=TST
# APP_C_AGENT_PREFIX=THA